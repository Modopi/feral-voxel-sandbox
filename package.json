{
  "name": "feral-voxel-sandbox",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:long": "node --test tests/long/*.test.js",
    "audit:design": "node tools/audit-content-design.mjs",
    "build:runtime": "node tools/build-runtime-content.mjs",
    "check:runtime": "node tools/build-runtime-content.mjs --check",
    "serve": "python3 -m http.server 8080 --directory app/src/main/assets",
    "build:assets": "node tools/build-visual-assets.mjs",
    "render:assets": "node tools/render-visual-assets.mjs",
    "serve:assets": "python3 -m http.server 8081 --directory .",
    "check:assets": "node tools/check-visual-assets.mjs",
    "author:assets": "python3 -m http.server 8081 --directory ."
  }
}
